# --- GitHub ---------------------------------------------------------------
# Personal access token (no scopes needed for public data). Create one at
# https://github.com/settings/tokens . Without it the app runs in DEMO mode
# and serves deterministic fake data so you can still try everything.
GITHUB_TOKEN=

# How long (seconds) GitHub responses are cached in memory. Default 900.
CACHE_TTL_SECONDS=900

# --- App ------------------------------------------------------------------
# Public URL of your deployment (used in embed snippets and Stripe redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign Pro license keys. Generate with: openssl rand -hex 32
LICENSE_SECRET=

# --- Storage --------------------------------------------------------------
# Production / Vercel: Upstash Redis (free tier is plenty). On Vercel add it from
# Marketplace -> Upstash -> Redis and these variables are injected for you
# (it may name them KV_REST_API_URL / KV_REST_API_TOKEN, which are also supported).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Without the two variables above, a JSON file is used instead (local dev, or a server
# with a persistent disk). Defaults to ./.data
# DATA_DIR=./.data

# Pro custom domains (v1 = manual provisioning): "host=username,host2=username2"
# Point the domain's DNS at your deployment, then add it here.
CUSTOM_DOMAINS=

# --- Stripe (monetization) ------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create two Prices in Stripe: $3/month recurring and $5 one-time.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
